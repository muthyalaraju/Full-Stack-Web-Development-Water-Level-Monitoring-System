# Backend Environment Variables Template
# Copy to .env for local development, or set in Render Environment Settings

# Server Configuration (Render injects PORT automatically)
PORT=5000
NODE_ENV=production

# PostgreSQL Connection URL
# Local:      postgresql://postgres:password@localhost:5432/smart_water_monitoring
# Hosted DB:  postgresql://username:password@ep-cool-db.us-east-2.aws.neon.tech/smart_water_monitoring?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_water_monitoring

# MQTT Broker Configuration
# Public default: mqtt://broker.emqx.io:1883
# Private broker: mqtt://username:password@broker.example.com:1883
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Frontend Origin for CORS Security (Supports comma-separated list of origins)
# Example: https://smart-water-monitoring.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-frontend-app.vercel.app
