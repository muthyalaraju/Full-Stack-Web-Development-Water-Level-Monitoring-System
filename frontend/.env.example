# Frontend Environment Variables Template (Vite)
# Copy to .env for local development, or set in Vercel project settings

# Backend REST API Base URL
# Local development: http://localhost:5000/api
# Production (Render): https://your-backend-app.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Backend Socket.IO Real-Time Stream URL
# Local development: http://localhost:5000
# Production (Render): https://your-backend-app.onrender.com
VITE_SOCKET_URL=http://localhost:5000

